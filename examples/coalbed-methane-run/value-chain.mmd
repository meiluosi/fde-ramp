flowchart LR
  subgraph UP["上游 · 勘探开发（钱最重）"]
    A1["资源评价<br/>选区/甜点"] --> A2["矿权取得<br/>探矿权→采矿权"]
    A2 --> A3["勘探<br/>地震/参数井/试采"]
    A3 --> A4["储量估算与备案<br/>探明/控制/预测"]
    A4 --> A5["开发方案<br/>井网/井型/层位"]
    A5 --> A6["钻完井<br/>直井/定向/水平/U型"]
    A6 --> A7["压裂改造<br/>分段/体积压裂"]
    A7 --> A8["排采<br/>排水降压→解吸产气"]
  end
  subgraph MID["中游 · 集输与净化"]
    B1["井场/阀组<br/>单井计量"] --> B2["采气管线<br/>星型/枝状"]
    B2 --> B3["集气站<br/>分离/计量/增压"]
    B3 --> B4["净化<br/>脱水/脱硫/脱碳"]
    B4 --> B5["外输管线<br/>或 CNG/LNG"]
  end
  subgraph DOWN["下游 · 利用与销售"]
    C1["管道气销售<br/>工业/民用/城燃"]
    C2["CNG/LNG<br/>车用/点供"]
    C3["瓦斯发电<br/>自发自用+上网"]
    C4["提纯/深加工<br/>待验证"]
  end
  subgraph SVC["油服与装备（不持矿权，卖服务）"]
    D1["物探/钻井队"]
    D2["压裂车组/支撑剂"]
    D3["排采设备/压缩机"]
    D4["工程设计/EPC"]
  end
  subgraph REG["监管（不产生收入，决定能不能干）"]
    E1["矿权与储量<br/>自然资源系统"]
    E2["开发方案/投资<br/>能源系统"]
    E3["安全：抽采达标<br/>矿山安监系统"]
    E4["环保：环评/水/甲烷<br/>生态环境系统"]
    E5["价格/补贴/管网<br/>发改+财政"]
  end
  A8 --> B1
  B5 --> C1
  B5 --> C2
  B3 --> C3
  B4 --> C4
  D1 -.服务.-> A6
  D2 -.服务.-> A7
  D3 -.服务.-> A8
  D4 -.服务.-> B3
  REG -.许可/考核.-> UP
  REG -.许可/考核.-> MID
  REG -.价格/补贴.-> DOWN
