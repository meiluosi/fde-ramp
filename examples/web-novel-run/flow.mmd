flowchart TD
  N1["① 选题/立项<br/>题材趋势+编辑策划"] --> N2["② 投稿/约稿<br/>作者提交或编辑邀约"]
  N2 --> N3["③ 签约评估<br/>潜力/合规/合同类型"]
  N3 --> N4["④ 签约盖章<br/>买断/保底/分成"]
  N4 --> N5["⑤ 大纲与黄金三章<br/>编辑给修改意见"]
  N5 --> N6["⑥ 章节连载<br/>日更+存稿+催更"]
  N6 --> N7["⑦ 机审+人审<br/>敏感词/三审三校"]
  N7 --> N8["⑧ 上架排期<br/>分类/标签/封面/简介"]
  N8 --> N9["⑨ 推荐与榜单<br/>算法+编辑推荐"]
  N9 --> N10["⑩ 付费/免费策略<br/>定价/会员/广告"]
  N10 --> N11["⑪ 收入结算<br/>订阅/广告/打赏"]
  N11 --> N12["⑫ 数据复盘<br/>追读/完读/留存/收入"]
  N12 --> N13["⑬ 加推或切书<br/>资源再分配"]
  N13 --> N14["⑭ 完结/太监<br/>完结审核+结算"]
  N14 --> N15["⑮ IP 评估<br/>有声/短剧/影视"]
  N6 -.断更风险.-> N16["⑯ 作者运营介入<br/>全勤/请假/解约"]
  N16 -.回到.-> N6
  N7 -.违规.-> N17["⑰ 整改/下架<br/>复审+记录"]
