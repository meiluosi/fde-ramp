flowchart LR
  subgraph PROD["① 内容生产"]
    A1["作者个人<br/>日更连载"]
    A2["工作室/团队<br/>枪手代笔"]
    A3["编辑策划<br/>选题与约稿"]
  end
  subgraph PLAT["② 签约 / 编辑 / 审核（平台核心）"]
    B1["签约与合同<br/>买断/保底/分成"]
    B2["编辑跟稿<br/>大纲/章节/催更"]
    B3["审核与合规<br/>机审+人审+三审三校"]
  end
  subgraph DIST["③ 分发运营"]
    C1["上架排期<br/>分类/标签/封面"]
    C2["推荐与榜单<br/>算法+编辑推荐"]
    C3["渠道分发<br/>APP/小程序/商店"]
  end
  subgraph MON["④ 商业化"]
    D1["付费订阅<br/>按章/包月/会员"]
    D2["免费广告<br/>激励视频/插屏"]
    D3["打赏与月票<br/>虚拟道具"]
  end
  subgraph IP["⑤ IP 与版权"]
    E1["有声"]
    E2["短剧/微短剧"]
    E3["影视/动漫/漫剧"]
    E4["出版/衍生品"]
    E5["出海翻译"]
  end
  subgraph SVC["⑥ 服务与工具"]
    F1["写作工具/AI"]
    F2["数据与榜单服务"]
    F3["代运营/经纪/MCN"]
    F4["版权代理/维权"]
  end
  subgraph REG["监管（不产生收入，能否决业务）"]
    G1["出版署：许可证/内容"]
    G2["网信办：生态/AI/未成年"]
    G3["广电：微短剧备案"]
    G4["版权局/法院：著作权"]
    G5["税务：稿酬/平台报送"]
  end
  A1 --> B1
  A2 --> B1
  A3 --> A1
  B1 --> B2 --> B3 --> C1
  C1 --> C2 --> C3
  C3 --> D1
  C3 --> D2
  C3 --> D3
  D1 --> E1
  D1 --> E2
  D2 --> E2
  E1 --> E3
  E2 --> E3
  E3 --> E4
  E1 --> E5
  E2 --> E5
  F1 -.工具.-> A1
  F1 -.工具.-> B2
  F2 -.数据.-> C2
  F3 -.服务.-> A2
  F4 -.服务.-> E1
  G1 -.许可与审查.-> B1
  G3 -.许可与备案.-> E2
